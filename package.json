{
  "name": "geuttae-yojeum",
  "private": true,
  "version": "0.1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:web": "vite --configLoader runner --host 127.0.0.1",
    "prebuild": "node scripts/clean-build.mjs",
    "build": "vite build && ait build",
    "prebuild:web": "node scripts/clean-build.mjs",
    "build:web": "vite build --configLoader runner",
    "build:concept-map": "tsx scripts/build-concept-map.ts",
    "check:concept-map": "tsx scripts/build-concept-map.ts --check",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest --configLoader runner",
    "test:run": "vitest run --configLoader runner",
    "validate:content": "tsx scripts/validate-content-library.ts",
    "validate:content:pack": "tsx scripts/validate-content-pack.ts",
    "validate:content:library": "tsx scripts/validate-content-library.ts",
    "test:e2e:install": "playwright install chromium webkit",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium-360 --project=chromium-390",
    "test:e2e:webkit": "playwright test --project=webkit-360 --project=webkit-390",
    "test:e2e:update": "playwright test tests/e2e/visual-regression.spec.ts --update-snapshots",
    "verify:quality": "npm run lint && npm run typecheck && npm run validate:content && npm run check:concept-map && npm run test:run",
    "verify:release": "npm run verify:quality && npm run test:e2e:install && npm run test:e2e && npm run build",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.0.1",
    "@emotion/react": "^11.14.0",
    "@toss/tds-colors": "latest",
    "@toss/tds-mobile": "latest",
    "@toss/tds-mobile-ait": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
